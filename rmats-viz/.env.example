POSTGRES_USER=rmats
POSTGRES_PASSWORD=rmats
POSTGRES_DB=rmatsdb
DATABASE_URL=postgresql+asyncpg://rmats:rmats@db:5432/rmatsdb
CORS_ORIGINS=["http://localhost:3000"]

# --- Backend (optional; defaults shown, see README "Configuration") ---------
# Indexed GRCh38 FASTA inside the backend container. The backend does NOT
# download it: run rmats-viz/data/setup_grch38_fasta.sh once on the host.
#GRCH38_FASTA=/data/GRCh38.fa
#SAMTOOLS_BIN=samtools
#MANE_CACHE_DB=/data/mane_cache.db
#MANE_GFF3=/data/MANE.GRCh38.ensembl_genomic.gff.gz
# Directory where the deep-analysis PDF export also writes every figure as a
# standalone SVG (one sub-directory per deep analysis). Unset = no SVG files.
#SVG_EXPORT_DIR=/data/svg_exports
